# MongoDB Atlas Connection String (DO NOT put real creds here)
# Example format:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.8ijuace.mongodb.net/mamacare?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.8ijuace.mongodb.net/mamacare?retryWrites=true&w=majority

# JWT Secret - put a real secret in server/.env (never commit that file)
JWT_SECRET=your_jwt_secret_here

# Server port
PORT=5000

# Google Gemini AI API Key - get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
