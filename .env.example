# MongoDB Atlas Connection String
# Get this from MongoDB Atlas dashboard
# Format: mongodb+srv://username:password@cluster.mongodb.net/database_name
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/mamacare

# JWT Secret Key
# Use a strong random string (e.g., generate with: openssl rand -hex 32)
# For development, use anything strong. For production, use strong random key.
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Server Port
PORT=5000

# Optional: Gemini/OpenAI API Key for AI Assistant (leave blank for mock responses)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
